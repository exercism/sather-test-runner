-- Test-runner scenario, maintained by hand; the exercise is a
-- two-fer variant.

class ALL_FAIL_TEST is
   include EXERCISM_TEST;

   main is
      class_name("ALL_FAIL");

      test("no name given", ALL_FAIL::two_fer(void), "One for you, one for me.");

      test("a name given", ALL_FAIL::two_fer("Alice"), "One for Alice, one for me.");

      test("another name given", ALL_FAIL::two_fer("Bob"), "One for Bob, one for me.");

      finish;
   end;
end; -- class ALL_FAIL_TEST
